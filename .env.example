# Anthropic API key used server-side to run each audit.
# Set this as an environment variable in Zeabur — do not commit a real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: only set this once there's a paid Ahrefs plan behind it.
# When present, Domain Rating / Ahrefs Rank switch from "AI Estimate" to
# "Verified · Ahrefs" in the UI. Leave unset to keep everything AI-estimated.
AHREFS_API_KEY=

