{
  // Probe on Cloudflare Workers (replaces main.py on Zeabur). static/ is the frontend; worker.js handles /api/*.
  // Secrets: ANTHROPIC_API_KEY (required for audits), AHREFS_API_KEY (optional). /api/health shows key_configured.
  "name": "probe-seo-analyzer",
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ANTHROPIC_MODEL": "claude-haiku-4-5-20251001" },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Overrides the *.thebooleanjulian.dev wildcard (Zeabur, which was 502). Rollback: remove and redeploy.
  "routes": [{ "pattern": "probe-seo-analyzer.thebooleanjulian.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
